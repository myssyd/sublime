{
  "name": "sublime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --parallel \"dev:*\"",
    "dev:convex": "bunx convex dev",
    "dev:next": "next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "cobalt:dev": "bunx node@22 node_modules/wrangler/bin/wrangler.js dev --config deploy/cobalt-cloudflare/wrangler.jsonc",
    "cobalt:deploy": "bunx node@22 node_modules/wrangler/bin/wrangler.js deploy --config deploy/cobalt-cloudflare/wrangler.jsonc",
    "cobalt:status": "bunx node@22 node_modules/wrangler/bin/wrangler.js containers list --config deploy/cobalt-cloudflare/wrangler.jsonc",
    "cobalt:types": "bunx node@22 node_modules/wrangler/bin/wrangler.js types deploy/cobalt-cloudflare/worker-configuration.d.ts --include-runtime false --config deploy/cobalt-cloudflare/wrangler.jsonc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/containers": "^0.3.7",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/stripe": "^0.1.4",
    "@convex-dev/workpool": "^0.4.9",
    "@fal-ai/client": "^1.10.1",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "music-metadata": "^11.14.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.369.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.119.0"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
