{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3004",
          "https://sublime.kiwi",
          "https://www.sublime.kiwi"
        ],
        "methods": ["GET", "PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
